# Partially sourced from "https://github.com/github/gitignore/blob/main/Godot.gitignore"

# Godot 4+ specific ignores
.godot/
/android/
.nomedia

# Godot-specific ignores
.import/
export.cfg
export_presets.cfg
export_credentials.cfg
*.tmp

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# Export outputs
*.exe
# Uncomment if your project does not version PCK files as runtime dependencies.
# *.pck

# Kinaban-specific ignores
!/bin/README.md
/bin
!/tmp/README.md
/tmp
